MONGODB_URI=mongodb://127.0.0.1:27017/investarena
JWT_SECRET=your-long-random-secret-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Copy this file to .env.local and put real keys there (NOT in .env.example)
# Live market data — both keys can be set; Twelve Data is tried first, Alpha Vantage as fallback
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
MARKET_DATA_PROVIDER=auto
MARKET_EXCHANGE=NSE
# Use .NSE for NSE-listed seed symbols; leave blank to try .NSE, .BSE, .NS, .BO
ALPHA_VANTAGE_SYMBOL_SUFFIX=.NSE
MARKET_REFRESH_MINUTES=15
MARKET_SYNC_BATCH_SIZE=4

# AI Portfolio Mentor — Groq recommended (free tier at console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional fallbacks:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# auto | groq | gemini | anthropic | openai
AI_PROVIDER=auto

# Daily portfolio snapshots cron
CRON_SECRET=your-cron-secret-here
