MONGODB_URI=mongodb://127.0.0.1:27017/investarena
JWT_SECRET=your-long-random-secret-here

# Live market data (use one or both; Twelve Data is preferred for NSE symbols)
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
# auto | twelvedata | alphavantage
MARKET_DATA_PROVIDER=auto
# NSE for Indian seed symbols (Twelve Data)
MARKET_EXCHANGE=NSE
# Suffix for Alpha Vantage Indian listings, e.g. .BSE or .NSE
ALPHA_VANTAGE_SYMBOL_SUFFIX=.BSE
# Minutes between automatic price refreshes on /api/market
MARKET_REFRESH_MINUTES=15
# How many symbols to refresh per market API request (rate-limit friendly)
MARKET_SYNC_BATCH_SIZE=4
